# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Runtime captures / user-generated vision data
snapshots/*
templates/*
recordings/*
!snapshots/.gitkeep
!templates/.gitkeep
!recordings/.gitkeep
# Runtime game profiles (v0.6+): only the example profile JSON is tracked
profiles/*
!profiles/example/
profiles/example/*
!profiles/example/profile.json
# Datasets exported outside recordings/ (scripts/recordings.py export --out)
dataset*.jsonl
*.jsonl.tmp

# Logs
logs/
*.log

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local config / secrets
.env
.env.*
config.local.json

# Local AI model artifacts / overrides
*.gguf
*.safetensors
*.onnx
models.local/
configs/models.local.json
